# Copy this file to .env and fill in the two URLs. .env is gitignored.
#
# Both are CSV exports of Ulria's sheet. From a published sheet, take the
# pubhtml link and turn it into a CSV export:
#
#   .../pubhtml#gid=853763455
#   .../pub?gid=853763455&single=true&output=csv
#
# Note the question mark: with the original '#' the gid never reaches the
# server and you always get the first tab.
#
# Then run:  python3 tools/update_spec_data.py

SPEC_SHEET_HEALER_URL=
SPEC_SHEET_SHADOW_URL=
