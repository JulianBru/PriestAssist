package-as: PriestAssist

# Use the hand-written CHANGELOG.md instead of an auto-generated commit log.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Libraries are embedded, so a -nolib zip makes sense for those who prefer
# standalone library addons.
enable-nolib-creation: yes

# Pulled fresh by the packager instead of relying on the checked-in copies.
externals:
  Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  # Same form BigWigs uses: the repository with a .git suffix, then the folder
  # inside it that actually holds the library. Without the subpath the packager
  # would copy the whole repository, and without .git it asks for credentials.
  Libs/LibSpecialization: https://github.com/BigWigsMods/LibSpecialization.git/LibSpecialization
  # The copy checked in is whatever was to hand while the buddy frame's range
  # indicator was written. This is the one that ships.
  Libs/LibRangeCheck-3.0: https://github.com/WeakAuras/LibRangeCheck-3.0.git/LibRangeCheck-3.0

# Shown as a relation on the CurseForge project page.
optional-dependencies:
  - libsharedmedia-3-0
  - libspecialization

# Development-only files that should not end up in the published zip.
ignore:
  - .github
  - .vscode
  - .claude
  - .gitignore
  - CURSEFORGE.md
  - docs
  - tools
  # Shipped by LibStub's own repository, of no use in the addon.
  - Libs/LibStub/tests
