package-as: PriestAssist

# Use the hand-written CHANGELOG.md instead of an auto-generated commit log.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Libraries are embedded, so a -nolib zip makes sense for those who prefer
# standalone library addons.
enable-nolib-creation: yes

# Pulled fresh by the packager instead of relying on the checked-in copies.
externals:
  Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  Libs/LibSpecialization:
    url: https://github.com/funkydude/LibSpecialization
    tag: latest

# Shown as a relation on the CurseForge project page.
optional-dependencies:
  - libsharedmedia-3-0
  - libspecialization

# Development-only files that should not end up in the published zip.
ignore:
  - .github
  - .vscode
  - .claude
  - .gitignore
  - CURSEFORGE.md
  - docs
  - tools
